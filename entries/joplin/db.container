[Container]
Image={{ .Image }}
HealthCmd=pg_isready -U joplin -d joplin
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
Environment=POSTGRES_DB=joplin
Environment="POSTGRES_PASSWORD={{ .Settings.POSTGRES_PASSWORD }}"
Environment=POSTGRES_USER=joplin
Volume={{ .Volumes.data }}:/var/lib/postgresql/data:Z
