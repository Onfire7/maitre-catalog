[Container]
Image={{ .Image }}
HealthCmd=curl -fsS http://localhost:7700/health
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
Environment="MEILI_MASTER_KEY={{ .Settings.MEILI_MASTER_KEY }}"
Environment=MEILI_NO_ANALYTICS=true
Volume={{ .Volumes.meilisearch }}:/meili_data:Z
