[Container]
Image={{ .Image }}
HealthCmd=healthcheck.sh --connect --innodb_initialized
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
Environment=MARIADB_DATABASE=monica
Environment="MARIADB_PASSWORD={{ .Settings.DB_PASSWORD }}"
Environment=MARIADB_RANDOM_ROOT_PASSWORD=true
Environment=MARIADB_USER=monicauser
Volume={{ .Volumes.mysql }}:/var/lib/mysql:Z
