[Container]
Image={{ .Image }}
HealthCmd=pg_isready -U nocodb -d nocodb
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
Environment=POSTGRES_DB=nocodb
Environment="POSTGRES_PASSWORD={{ .Settings.DB_PASSWORD }}"
Environment=POSTGRES_USER=nocodb
Volume={{ .Volumes.pgdata }}:/var/lib/postgresql/data:Z
